NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citizen_grievance
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
# Demo accounts are created only by running npm run seed in development.
SEED_ADMIN_EMAIL=admin@civicportal.local
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_DEPT_EMAIL=department@civicportal.local
SEED_DEPT_PASSWORD=DeptDemo123!

# Optional image storage. Without Cloudinary, images are stored locally in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email notifications (SMTP). Leave blank to use in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CivicConnect <no-reply@example.com>"

# Optional SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
