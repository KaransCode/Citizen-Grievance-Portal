{
  "name": "citizen-grievance-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack citizen grievance reporting and resolution portal",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "db:init": "npm run db:init --workspace backend",
    "seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
