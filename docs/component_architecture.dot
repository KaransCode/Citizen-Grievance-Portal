  subgraph cluster_api {label="Backend · Express"; color="#cfe0f5"; style="rounded"; api[label="API router + schemas"]; auth[label="Auth / RBAC / CSRF"]; complaint[label="Complaint workflow service"]; upload[label="Image processing / storage"]; analytics[label="Admin analytics / audit"]; notification[label="Notification service"];}
  subgraph cluster_data {label="Persistence"; color="#eadcb9"; style="rounded"; pg[label="PostgreSQL",shape=cylinder,fillcolor="#fff4dd"]; cloud[label="Cloud storage",shape=folder,fillcolor="#f1eaff"]; provider[label="SMTP / SMS",fillcolor="#fff0f0"];}
